{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://limonat.example/schemas/character-1.0.json",
  "title": "Limonat character command / save document v1.0",
  "description": "Generated from the Limonat Character Creator asset registry. Asset id enums list the assets that exist in this version.",
  "type": "object",
  "required": [
    "schemaVersion",
    "character"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0"
    },
    "kind": {
      "const": "limonat-character"
    },
    "id": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "replace",
        "patch"
      ]
    },
    "baseCharacter": {
      "type": "string",
      "enum": [
        "base_limonat_hero",
        "base_classic_block",
        "base_chibi"
      ]
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "maxLength": 600
        },
        "source": {
          "enum": [
            "photo",
            "cartoon",
            "anime",
            "game",
            "drawing",
            "other"
          ]
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "maxLength": 40
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "typeId": {
              "type": "string",
              "enum": [
                "body_toon_01",
                "body_block_01"
              ]
            },
            "skinColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "proportions": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "headScale": {
                  "type": "number",
                  "minimum": 0.8,
                  "maximum": 1.35
                },
                "torsoWidth": {
                  "type": "number",
                  "minimum": 0.8,
                  "maximum": 1.3
                },
                "torsoLength": {
                  "type": "number",
                  "minimum": 0.85,
                  "maximum": 1.2
                },
                "armLength": {
                  "type": "number",
                  "minimum": 0.85,
                  "maximum": 1.2
                },
                "legLength": {
                  "type": "number",
                  "minimum": 0.75,
                  "maximum": 1.25
                },
                "limbThickness": {
                  "type": "number",
                  "minimum": 0.75,
                  "maximum": 1.35
                }
              }
            }
          }
        },
        "head": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "shapeId": {
              "type": "string",
              "enum": [
                "head_round_01",
                "head_block_01",
                "head_tall_01"
              ]
            }
          }
        },
        "hair": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "assetId": {
              "type": "string",
              "enum": [
                "hair_none",
                "hair_buzz_01",
                "hair_short_01",
                "hair_spiky_01",
                "hair_long_01",
                "hair_bob_01",
                "hair_ponytail_01",
                "hair_bun_01",
                "hair_afro_01",
                "hair_mohawk_01",
                "hair_tuft_01"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "secondaryColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            }
          }
        },
        "face": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "eyes": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "styleId": {
                  "type": "string",
                  "enum": [
                    "eyes_round_big_01",
                    "eyes_dot_01",
                    "eyes_block_01",
                    "eyes_anime_01",
                    "eyes_sleepy_01",
                    "eyes_happy_01"
                  ]
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "secondaryColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "gaze": {
                  "enum": [
                    "center",
                    "left",
                    "right",
                    "up",
                    "down"
                  ]
                }
              }
            },
            "eyebrows": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "styleId": {
                  "type": "string",
                  "enum": [
                    "brows_none",
                    "brows_flat_01",
                    "brows_thick_01",
                    "brows_angry_01",
                    "brows_sad_01",
                    "brows_arched_01"
                  ]
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "secondaryColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                }
              }
            },
            "mouth": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "styleId": {
                  "type": "string",
                  "enum": [
                    "mouth_dash_01",
                    "mouth_smile_01",
                    "mouth_grin_01",
                    "mouth_open_01",
                    "mouth_frown_01",
                    "mouth_cat_01"
                  ]
                }
              }
            },
            "facialHair": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "assetId": {
                  "type": "string",
                  "enum": [
                    "facialhair_none",
                    "facialhair_mustache_01",
                    "facialhair_goatee_01",
                    "facialhair_beard_full_01",
                    "facialhair_stubble_01"
                  ]
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "secondaryColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                }
              }
            },
            "details": {
              "type": "array",
              "maxItems": 6,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "assetId"
                ],
                "properties": {
                  "assetId": {
                    "type": "string",
                    "enum": [
                      "detail_blush_01",
                      "detail_freckles_01",
                      "detail_scar_cheek_01",
                      "detail_whiskers_01",
                      "detail_bandage_01"
                    ]
                  },
                  "color": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "secondaryColor": {
                    "type": "string",
                    "pattern": "^#[0-9A-Fa-f]{6}$"
                  },
                  "side": {
                    "enum": [
                      "left",
                      "right",
                      "both"
                    ]
                  }
                }
              }
            }
          }
        },
        "headwear": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "assetId": {
              "type": "string",
              "enum": [
                "hat_none",
                "hat_beanie_01",
                "hat_cap_01",
                "hat_straw_01",
                "hat_headband_01",
                "hat_tophat_01"
              ]
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "secondaryColor": {
              "type": "string",
              "pattern": "^#[0-9A-Fa-f]{6}$"
            },
            "material": {
              "type": "string",
              "enum": [
                "cloth",
                "denim",
                "leather",
                "plastic",
                "metal",
                "emissive"
              ]
            }
          }
        },
        "clothing": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "assetId": {
                  "type": "string",
                  "enum": [
                    "top_none",
                    "top_tshirt_01",
                    "top_vneck_01",
                    "top_tank_01",
                    "top_longsleeve_01",
                    "top_collar_shirt_01",
                    "top_striped_01"
                  ]
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "secondaryColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "material": {
                  "type": "string",
                  "enum": [
                    "cloth",
                    "denim",
                    "leather",
                    "plastic",
                    "metal",
                    "emissive"
                  ]
                }
              }
            },
            "outerwear": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "assetId": {
                  "type": "string",
                  "enum": [
                    "outer_none",
                    "outer_jacket_open_01",
                    "outer_jacket_closed_01",
                    "outer_hoodie_01",
                    "outer_vest_open_01",
                    "outer_coat_long_01"
                  ]
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "secondaryColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "material": {
                  "type": "string",
                  "enum": [
                    "cloth",
                    "denim",
                    "leather",
                    "plastic",
                    "metal",
                    "emissive"
                  ]
                }
              }
            },
            "bottom": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "assetId": {
                  "type": "string",
                  "enum": [
                    "bottom_shorts_01",
                    "bottom_shorts_rolled_01",
                    "bottom_pants_straight_01",
                    "bottom_cargo_01",
                    "bottom_skirt_01"
                  ]
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "secondaryColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "material": {
                  "type": "string",
                  "enum": [
                    "cloth",
                    "denim",
                    "leather",
                    "plastic",
                    "metal",
                    "emissive"
                  ]
                }
              }
            },
            "shoes": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "assetId": {
                  "type": "string",
                  "enum": [
                    "shoes_none",
                    "shoes_sneakers_01",
                    "shoes_boots_01",
                    "shoes_sandals_01",
                    "shoes_dress_01"
                  ]
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "secondaryColor": {
                  "type": "string",
                  "pattern": "^#[0-9A-Fa-f]{6}$"
                },
                "material": {
                  "type": "string",
                  "enum": [
                    "cloth",
                    "denim",
                    "leather",
                    "plastic",
                    "metal",
                    "emissive"
                  ]
                }
              }
            }
          }
        },
        "accessories": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "assetId"
            ],
            "properties": {
              "assetId": {
                "type": "string",
                "enum": [
                  "acc_glasses_round_01",
                  "acc_glasses_square_01",
                  "acc_sunglasses_01",
                  "acc_headphones_01",
                  "acc_scarf_01",
                  "acc_necklace_01",
                  "acc_lemon_badge_01",
                  "acc_backpack_01",
                  "acc_cape_01",
                  "acc_belt_01",
                  "acc_watch_01",
                  "acc_sword_01",
                  "acc_shield_01"
                ]
              },
              "color": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "secondaryColor": {
                "type": "string",
                "pattern": "^#[0-9A-Fa-f]{6}$"
              },
              "material": {
                "type": "string",
                "enum": [
                  "cloth",
                  "denim",
                  "leather",
                  "plastic",
                  "metal",
                  "emissive"
                ]
              },
              "attachTo": {
                "enum": [
                  "head_top",
                  "face",
                  "neck",
                  "chest",
                  "back",
                  "waist",
                  "hip_left",
                  "hip_right",
                  "wrist_left",
                  "wrist_right",
                  "hand_left",
                  "hand_right"
                ]
              }
            }
          }
        }
      }
    },
    "uncertain": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "field": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "unsupported": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "properties": {
              "feature": {
                "type": "string"
              },
              "closestSubstitute": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "meta": {
      "type": "object"
    }
  }
}
